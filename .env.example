APP_NAME=Sommy
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=holzdream_erp
DB_USERNAME=root
DB_PASSWORD=

SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=youremail@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="youremail@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# Agentes IA (al menos una de las dos para que el bot de ventas funcione)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# MercadoPago Checkout Pro (credenciales de la cuenta del negocio)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

# WhatsApp Cloud API (Meta) — ver docs/GUIA_META_WHATSAPP.md
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_VERIFY_TOKEN=cambia-este-token
WHATSAPP_APP_SECRET=
# Producto "API de Instagram" (app propia): su clave secreta firma los webhooks de IG
IG_APP_SECRET=
# Token de acceso de la cuenta de IG (API de Instagram; renovarlo antes de los 60 días)
IG_ACCESS_TOKEN=

# Messenger / Instagram Direct (misma app de Meta, token de la pagina de Facebook)
FB_PAGE_ID=
FB_PAGE_TOKEN=
IG_ACCOUNT_ID=

# Estudio de Publicaciones (IA)
# Escenas de producto: Google AI Studio > https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Videos UGC con IA (Veo, misma API key; requiere plan pago de Google AI)
GEMINI_VIDEO_MODEL=veo-3.0-fast-generate-001
# Copys (usa OPENAI_API_KEY de arriba)
PUBLICACIONES_COPY_MODEL=gpt-4o-mini
