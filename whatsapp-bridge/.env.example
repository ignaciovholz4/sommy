# Puerto donde escucha el bridge (Laravel le pega a este puerto/URL)
PORT=3300

# URL base de Laravel, donde vive el webhook que recibe los mensajes entrantes
LARAVEL_URL=http://holzdream.test

# Debe coincidir con WHATSAPP_BRIDGE_TOKEN del .env de Laravel (Laravel -> bridge, para /send y /qr)
BRIDGE_TOKEN=cambia-este-token

# Debe coincidir con WHATSAPP_BRIDGE_INBOUND_TOKEN del .env de Laravel (bridge -> Laravel, para el webhook)
INBOUND_TOKEN=cambia-este-token-tambien
